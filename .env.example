# Required: fill the credential encryption key before starting the Factory Server.
# No admin token is needed: a fixed local identity is assigned without verification.
# Loopback-only: never expose this server through a proxy, tunnel, or LAN address.
# Generate with: openssl rand -base64 32
FACTORY_CREDENTIAL_ENCRYPTION_KEY=

