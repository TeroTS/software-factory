# Required: fill the credential encryption key before starting the Factory Server.
# No admin token is needed: a fixed local identity is assigned without verification.
# Loopback-only: never expose this server through a proxy, tunnel, or LAN address.
# Generate with: openssl rand -base64 32
FACTORY_CREDENTIAL_ENCRYPTION_KEY=

# Local SQLite; relative paths resolve against the Factory project root.
LIBSQL_URL=file:./data/factory.db

# Local command execution; defaults to ~/.mastracode/web/sandboxes.
# MASTRACODE_LOCAL_SANDBOX_ROOT=/absolute/path/to/sandboxes

# Optional self-managed GitHub App: enable/fill ALL six values together.
# Keep secrets local; see docs/github-setup.md. No webhook secret or PAT is needed.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="paste the PEM contents here; literal \\n escapes are supported"
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=
# Separate stable OAuth state key; generate once with: openssl rand -base64 32
# FACTORY_STATE_SECRET=

# PORT=4111
# MASTRACODE_PUBLIC_URL=http://localhost:4111
