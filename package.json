{
  "name": "software-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests — all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "predev": "node --env-file-if-exists=.env scripts/validate-env.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mastra/code-sdk": "1.15.0",
    "@mastra/core": "1.79.0",
    "@mastra/factory": "0.24.0",
    "@mastra/libsql": "1.27.0",
    "@mastra/memory": "1.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "mastra": "1.35.0",
    "playwright-core": "1.64.1",
    "prettier": "3.8.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
